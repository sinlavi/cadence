<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_artwork"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:contentDescription="@string/widget_artwork_desc"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_artwork_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_idle_title"
                android:textColor="#F8FAFC"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_idle_artist"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_album"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_favorite"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_favorite"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_favorite_border" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_shuffle"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_shuffle"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_shuffle" />

        <ImageButton
            android:id="@+id/widget_prev"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_previous"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_prev" />

        <ImageButton
            android:id="@+id/widget_play_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/widget_play_circle"
            android:contentDescription="@string/action_play_pause"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_play" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_next"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_next" />

        <ImageButton
            android:id="@+id/widget_repeat"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_repeat"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_repeat" />
    </LinearLayout>
</LinearLayout>
