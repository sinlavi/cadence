<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/widget_artwork_desc"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_artwork_placeholder" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_idle_title"
        android:textColor="#F8FAFC"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/widget_play_pause"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/widget_play_circle"
        android:contentDescription="@string/action_play_pause"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_play" />

    <ImageButton
        android:id="@+id/widget_next"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="2dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_next"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_next" />
</LinearLayout>
